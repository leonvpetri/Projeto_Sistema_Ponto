# SQLite usado pela suíte e2e (test/setup-e2e.ts apaga e recria este arquivo
# a cada run de test/**/*.e2e-spec.ts) — caminho relativo é resolvido pelo
# Prisma a partir de prisma/, então "file:./test.db" vira prisma/test.db.
DATABASE_URL="file:./test.db"

# Não precisa ser secreto (ambiente de teste) — qualquer valor serve.
JWT_SECRET="test-secret"
JWT_EXPIRES_IN="8h"

# Usado pelo ApiKeyGuard para autenticar POST /extracoes-pendentes (header
# x-api-key). Sem essa variável, todo teste que passa por esse endpoint
# (fila do WhatsApp / n8n) falha com 401, mesmo com o header correto.
N8N_WEBHOOK_SECRET="test-n8n-secret"

# Porta usada pela suíte e2e ao subir a aplicação Nest de teste.
PORT=3001
