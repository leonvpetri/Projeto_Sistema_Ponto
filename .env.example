# SQLite local — em dev, o Prisma resolve o path relativo a partir de prisma/,
# então "file:./dev.db" vira prisma/dev.db (não a raiz do projeto).
DATABASE_URL="file:./dev.db"

# Porta do backend. Em algumas VPS a porta 3000 já está ocupada por outro
# serviço (ex.: Easypanel) — confirme antes de usar o default.
PORT=3000

# Gerar com: openssl rand -hex 32
JWT_SECRET="troque-por-um-valor-gerado-com-openssl-rand-hex-32"

# Usado pelo workflow n8n para autenticar POST /extracoes-pendentes (header x-api-key).
N8N_WEBHOOK_SECRET="troque-por-um-valor-gerado-com-openssl-rand-hex-32"

# Necessária para POST /registros-ponto/extrair-foto (extração de dados de
# foto do cartão de ponto via Claude). Sem isso, o endpoint retorna 503.
ANTHROPIC_API_KEY=""
